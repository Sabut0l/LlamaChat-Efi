@echo off
chcp 65001 >nul
REM ============================================================
REM  preflight.bat — БЕСПЛАТНЫЕ проверки ПЕРЕД арендой GPU
REM
REM  Из семи причин прошлого провала ШЕСТЬ ловятся здесь, на своём
REM  ПК, без CUDA, за минуту. Аренда RTX 3090 = 40 руб/час;
REM  прошлый заход стоил 700 руб и дал модель без персоны.
REM
REM  Запускать ДВАЖДЫ:
REM    1) до prepare_data.py  — пройдут проверки 1 и 2
REM    2) после prepare_data.py — добавится проверка 3 (токенизатор)
REM
REM  Код возврата: 0 = можно платить за GPU, 1 = НЕЛЬЗЯ.
REM ============================================================
setlocal
set FAILED=0

echo.
echo ============================================================
echo  [1/3] check_sync.py — синхронизация Python ^<-^> C
echo        (ловит обрезанный макрос CHAT_SYSTEM_PROMPT, причина 6)
echo ============================================================
python check_sync.py
if errorlevel 1 (
  echo.
  echo   ^>^>^> ПРОВАЛ: prepare_data.py и LlamaChat.c РАСХОДЯТСЯ.
  echo   ^>^>^> Модель выучит один системный промпт, а приложение подаст другой.
  set FAILED=1
)

echo.
echo ============================================================
echo  [2/3] prepare_data.py --dry-run — состав корпуса
echo        (ловит анекдоты в персоне, редкие ^<CMD^>, невыученное имя)
echo ============================================================
python prepare_data.py --dry-run
if errorlevel 1 (
  echo.
  echo   ^>^>^> ПРОВАЛ: prepare_data.py не отработал.
  set FAILED=1
)
echo.
echo   Глазами проверь проценты выше. Норма:
echo     exit ~15%%, askpass ~11.5%%, openfile ~8%%, sysinfo ~4%%,
echo     (конфиг: ~8%%, Злобыч ~6%%
echo   Если "Злобыч" ниже 3%% — модель НЕ выучит своё имя.
echo   В прошлый раз было 1.22%% — отсюда "Обижаешь. Я лучше."
echo   на вопрос "Как тебя зовут?".

echo.
echo ============================================================
echo  [3/3] verify_tokenizer.py — обучение == инференс
echo        (ловит расхождение токенизации, причина 4)
echo ============================================================
if not exist data\tok8192.model (
  echo   [пропуск] data\tok8192.model ещё нет.
  echo   Это НОРМАЛЬНО до первого запуска prepare_data.py.
  echo   ОБЯЗАТЕЛЬНО запусти preflight.bat ЕЩЁ РАЗ после prepare_data.py:
  echo   эта проверка — единственная, что ловит баг, невидимый в логах обучения.
) else (
  python verify_tokenizer.py
  if errorlevel 1 (
    echo.
    echo   ^>^>^> ПРОВАЛ: Python и C токенизируют по-разному.
    echo   ^>^>^> Модель выучит команды и не выдаст НИ ОДНОЙ в EFI-приложении.
    set FAILED=1
  )
)

echo.
echo ============================================================
if "%FAILED%"=="1" (
  echo   ИТОГ: ПРОВАЛ. НЕ АРЕНДУЙ GPU.
  echo   Почини причины выше — это бесплатно. Час аренды = 40 руб.
  echo ============================================================
  endlocal
  exit /b 1
)
echo   ИТОГ: всё чисто. Можно арендовать GPU и запускать train_base.bat
echo ============================================================
endlocal
exit /b 0
